# -----------------------------------------------------------------------------
.pytest_cache/
.coverage
htmlcov/
__pycache__/
*.py[cod]
.cache/
.turbo/
.eslintcache

# -----------------------------------------------------------------------------
# Temporary backups
# -----------------------------------------------------------------------------
*.bak
*.orig
*.rej
runtime-images/domestic/apks/*.apk
runtime-images/domestic/apks/*.apks
runtime-images/domestic/apks/*.xapk

