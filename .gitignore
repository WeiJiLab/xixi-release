# Node.js / React / Vite
# -----------------------------------------------------------------------------
node_modules/
dist/
.vite/
*.tsbuildinfo
.npm/
.pnpm-store/
.yarn/cache/
.yarn/unplugged/
coverage/
.nyc_output/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# -----------------------------------------------------------------------------
# Rust / Cargo / Tauri
# -----------------------------------------------------------------------------
target/
**/src-tauri/gen/schemas/
*.dSYM/

# Cargo.lock is intentionally committed for application projects.

